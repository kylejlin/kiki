start File

struct File {
    items: OptItems
}

enum OptItems {
    Zero
    Snoc(OptItems FileItem)
}

enum FileItem {
    Start($StartKw $UpperName)
    Struct(Struct)
    Enum(Enum)
    ManualNonTerminal(ManualNonTerminal)
    GeneratedTerminal(GeneratedTerminal)
    ManualTerminal(ManualTerminal)
    Bridge($BridgeKw Path)
}

struct Struct {
    prefix: OptRustStringLiteral
    _: $StructKw
    name: $UpperName
    fieldset: Fieldset
}

struct Enum {
    prefix: OptRustStringLiteral
    _: $EnumKw
    name: $UpperName
    _: $LCurly
    variants: EnumVariants
    _: $RCurly
}

struct ManualNonTerminal {
    _: $ManualKw
    name: $UpperName
    override_: OptEqualAtUpperName
    lifetimes: OptSingleQuoteLowerNames
    _: $LCurly
    variants: ManualNonTerminalVariants
    _: $RCurly
}

struct GeneratedTerminal {
    prefix: OptRustStringLiteral
    _: $TerminalKw
    name: $UpperName
    global_lifetimes: OptSingleQuoteLowerNames
    _: $LCurly
    variants: OptTerminalEnumVariants
    _: $RCurly
}

struct ManualTerminal {
    _: $ManualKw
    _: $TerminalKw
    name: $UpperName
    override_: OptEqualAtUpperName
    global_lifetimes: OptSingleQuoteLowerNames
    _: $LCurly
    variants: OptTerminalEnumVariants
    _: $RCurly
}

enum OptRustStringLiteral {
    None
    Some($RustStringLiteral)
}

enum Fieldset {
    Empty
    Named(NamedFieldset)
    Tuple(TupleFieldset)
}

struct NamedFieldset {
    _: $LCurly
    fields: NamedFields
    _: $RCurly
}

enum NamedFields {
    One(NamedField)
    Snoc(NamedFields NamedField)
}

struct NamedField {
    name: UnderscoreOrLowerName
    _: $Colon
    symbol: GrammarSymbolOrSelf
}

struct TupleFieldset {
    _: $LParen
    fields: TupleFields
    _: $RParen
}

enum TupleFields {
    One(TupleField)
    Snoc(TupleFields TupleField)
}

enum TupleField {
    Used(GrammarSymbolOrSelf)
    Skipped($Underscore $Colon GrammarSymbolOrSelf)
}

enum EnumVariants {
    One(EnumVariant)
    Snoc(EnumVariants EnumVariant)
}

struct EnumVariant {
    name: $UpperName
    fieldset: Fieldset
}

enum ManualNonTerminalVariants {
    One(ManualNonTerminalVariant)
    Snoc(ManualNonTerminalVariants ManualNonTerminalVariant)
}

struct ManualNonTerminalVariant {
    function: $AtLowerName
    inputs: OptTupleFieldset
}

enum OptTupleFieldset {
    None
    Some(TupleFieldset)
}

enum OptTerminalEnumVariants {
    Zero
    Snoc(OptTerminalEnumVariants TerminalEnumVariant)
}

struct TerminalEnumVariant {
    name: $DollarUpperName
    override_: OptEqualAtUpperName
    lifetimes: OptSingleQuoteLowerNames
}

enum OptEqualAtUpperName {
    None
    Some($Equal $AtUpperName)
}

enum Path {
    One(Name)
    Snoc(Path $DoubleColon Name)
}

enum OptSingleQuoteLowerNames {
    Zero
    Snoc(OptSingleQuoteLowerNames $SingleQuoteLowerName)
}

#[derive(Debug, Clone, PartialEq, Eq)]
enum Name {
    Upper($UpperName)
    Lower($LowerName)
}

#[derive(Debug, Clone, PartialEq, Eq)]
enum UnderscoreOrLowerName {
    Underscore($Underscore)
    Lower($LowerName)
}

#[derive(Debug, Clone, PartialEq, Eq)]
enum GrammarSymbolOrSelf {
    Upper($UpperName)
    DollarUpper($DollarUpperName)
    Self_($UpperSelfKw)
}

#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
terminal Token {
    $StartKw: crate::cst::kiki_bridge::span_of::StartKw
    $StructKw: crate::cst::kiki_bridge::span_of::StructKw
    $EnumKw: crate::cst::kiki_bridge::span_of::EnumKw
    $ManualKw: crate::cst::kiki_bridge::span_of::ManualKw
    $TerminalKw: crate::cst::kiki_bridge::span_of::TerminalKw
    $BridgeKw: crate::cst::kiki_bridge::span_of::BridgeKw
    $UpperSelfKw: crate::cst::kiki_bridge::span_of::UpperSelfKw

    $Underscore: crate::cst::kiki_bridge::span_of::Underscore
    $LParen: crate::cst::kiki_bridge::span_of::LParen
    $RParen: crate::cst::kiki_bridge::span_of::RParen
    $LSquare: crate::cst::kiki_bridge::span_of::LSquare
    $RSquare: crate::cst::kiki_bridge::span_of::RSquare
    $LCurly: crate::cst::kiki_bridge::span_of::LCurly
    $RCurly: crate::cst::kiki_bridge::span_of::RCurly
    $Comma: crate::cst::kiki_bridge::span_of::Comma
    $DoubleColon: crate::cst::kiki_bridge::span_of::DoubleColon
    $Colon: crate::cst::kiki_bridge::span_of::Colon
    $Equal: crate::cst::kiki_bridge::span_of::Equal
    $Octothorpe: crate::cst::kiki_bridge::span_of::Octothorpe

    $UpperName: crate::cst::kiki_bridge::span_of::UpperName
    $LowerName: crate::cst::kiki_bridge::span_of::LowerName
    $DollarUpperName: crate::cst::kiki_bridge::span_of::DollarUpperName
    $AtUpperName: crate::cst::kiki_bridge::span_of::AtUpperName
    $AtLowerName: crate::cst::kiki_bridge::span_of::AtLowerName
    $SingleQuoteLowerName: crate::cst::kiki_bridge::span_of::SingleQuoteLowerName

    $RustStringLiteral: crate::cst::kiki_bridge::span_of::RustStringLiteral
}
