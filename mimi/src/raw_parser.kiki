start File

struct File {
    items: OptItems
}

enum OptItems {
    Zero
    Snoc(OptItems FileItem)
}

enum FileItem {
    Start($StartKw $UpperName)
    Struct(Struct)
    Enum(Enum)
    Manual(Manual)
    Terminal(TerminalEnum)
    Bridge($BridgeKw Path)
}

struct Struct {
    prefix: OptRustStringLiteral
    _: $StructKw
    name: $UpperName
    fieldset: Fieldset
}

struct Enum {
    prefix: OptRustStringLiteral
    _: $EnumKw
    name: $UpperName
    _: $LCurly
    variants: EnumVariants
    _: $RCurly
}

struct Manual {
    _: $ManualKw
    name: $UpperName
    override_: OptEqualAtUpperName
    _: $LCurly
    variants: ManualVariants
    _: $RCurly
}

struct TerminalEnum {
    prefix: OptRustStringLiteral
    _: $TerminalKw
    name: $UpperName
    _: $LCurly
    variants: OptTerminalEnumVariants
    _: $RCurly
}

enum OptRustStringLiteral {
    None
    Some($RustStringLiteral)
}

enum Fieldset {
    Empty
    Named(NamedFieldset)
    Tuple(TupleFieldset)
}

struct NamedFieldset {
    _: $LCurly
    fields: NamedFields
    _: $RCurly
}

enum NamedFields {
    One(NamedField)
    Snoc(NamedFields NamedField)
}

struct NamedField {
    name: UnderscoreOrLowerName
    _: $Colon
    symbol: GrammarSymbol
}

struct TupleFieldset {
    _: $LParen
    fields: TupleFields
    _: $RParen
}

enum TupleFields {
    One(TupleField)
    Snoc(TupleFields TupleField)
}

enum TupleField {
    Used(GrammarSymbol)
    Skipped($Underscore $Colon GrammarSymbol)
}

enum EnumVariants {
    One(EnumVariant)
    Snoc(EnumVariants EnumVariant)
}

struct EnumVariant {
    name: $UpperName
    fieldset: Fieldset
}

enum ManualVariants {
    One(ManualVariant)
    Snoc(ManualVariants ManualVariant)
}

struct ManualVariant {
    function: $AtLowerName
    inputs: OptTupleFieldset
}

enum OptTupleFieldset {
    None
    Some(TupleFieldset)
}

enum OptTerminalEnumVariants {
    Zero
    Snoc(OptTerminalEnumVariants TerminalEnumVariant)
}

struct TerminalEnumVariant {
    name: $DollarUpperName
    override_: OptEqualAtUpperName
}

enum OptEqualAtUpperName {
    None
    Some($Equal $AtUpperName)
}

enum Path {
    One(Name)
    Snoc(Path $DoubleColon Name)
}

#[derive(Debug, Clone, PartialEq, Eq)]
enum Name {
    Upper($UpperName)
    Lower($LowerName)
}

#[derive(Debug, Clone, PartialEq, Eq)]
enum UnderscoreOrLowerName {
    Underscore($Underscore)
    Lower($LowerName)
}

#[derive(Debug, Clone, PartialEq, Eq)]
enum GrammarSymbol {
    Upper($UpperName)
    DollarUpper($DollarUpperName)
}

#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
terminal Token {
    $StartKw: crate::token::span_of::StartKw
    $StructKw: crate::token::span_of::StructKw
    $EnumKw: crate::token::span_of::EnumKw
    $ManualKw: crate::token::span_of::ManualKw
    $TerminalKw: crate::token::span_of::TerminalKw
    $BridgeKw: crate::token::span_of::BridgeKw

    $Underscore: crate::token::span_of::Underscore
    $LParen: crate::token::span_of::LParen
    $RParen: crate::token::span_of::RParen
    $LSquare: crate::token::span_of::LSquare
    $RSquare: crate::token::span_of::RSquare
    $LCurly: crate::token::span_of::LCurly
    $RCurly: crate::token::span_of::RCurly
    $Comma: crate::token::span_of::Comma
    $DoubleColon: crate::token::span_of::DoubleColon
    $Colon: crate::token::span_of::Colon
    $Equal: crate::token::span_of::Equal
    $Octothorpe: crate::token::span_of::Octothorpe

    $UpperName: crate::token::span_of::UpperName
    $LowerName: crate::token::span_of::LowerName
    $DollarUpperName: crate::token::span_of::DollarUpperName
    $AtUpperName: crate::token::span_of::AtUpperName
    $AtLowerName: crate::token::span_of::AtLowerName

    $RustStringLiteral: crate::token::span_of::RustStringLiteral
}
