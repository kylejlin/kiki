start File

struct File {
    items: OptItems
}

manual OptItems {
    @vec_nil
    @vec_snoc(OptItems FileItem)
}

enum FileItem {
    Start($StartKw $UpperName)
    Struct(Struct)
    Enum(Enum)
    Manual(Manual)
    Terminal(TerminalEnum)
    Bridge($BridgeKw Path)
}

struct Struct {
    prefix: OptRustStringLiteral
    _: $StructKw
    name: $UpperName
    fieldset: Fieldset
}

struct Enum {
    prefix: OptRustStringLiteral
    _: $EnumKw
    name: $UpperName
    _: $LCurly
    variants: OptEnumVariants
    _: $RCurly
}

struct Manual {
    _: $ManualKw
    name: $UpperName
    override_: OptEqualAtUpperName
    _: $LCurly
    variants: OptManualVariants
    _: $RCurly
}

struct TerminalEnum {
    prefix: OptRustStringLiteral
    _: $TerminalKw
    name: $UpperName
    _: $LCurly
    variants: OptTerminalEnumVariants
    _: $RCurly
}

manual OptRustStringLiteral {
    @option_none
    @option_some($RustStringLiteral)
}

enum Fieldset {
    Empty
    Named(NamedFieldset)
    Tuple(TupleFieldset)
}

struct NamedFieldset {
    _: $LCurly
    fields: NamedFields
    _: $RCurly
}

manual NamedFields {
    @vec_one(NamedField)
    @vec_snoc(NamedFields NamedField)
}

struct NamedField {
    name: UnderscoreOrLowerName
    _: $Colon
    symbol: GrammarSymbol
}

struct TupleFieldset {
    _: $LParen
    fields: TupleFields
    _: $RParen
}

manual TupleFields {
    @vec_one(TupleField)
    @vec_snoc(TupleFields TupleField)
}

enum TupleField {
    Used(GrammarSymbol)
    Skipped($Underscore $Colon GrammarSymbol)
}

manual OptEnumVariants {
    @vec_nil
    @vec_snoc(OptEnumVariants EnumVariant)
}

struct EnumVariant {
    name: $UpperName
    fieldset: Fieldset
}

manual OptManualVariants {
    @vec_nil
    @vec_snoc(OptManualVariants ManualVariant)
}

struct ManualVariant {
    function: $AtLowerName
    inputs: OptTupleFieldset
}

manual OptTupleFieldset {
    @option_none
    @option_some(TupleFieldset)
}

manual OptTerminalEnumVariants {
    @vec_nil
    @vec_snoc(OptTerminalEnumVariants TerminalEnumVariant)
}

struct TerminalEnumVariant {
    name: $DollarUpperName
    override_: OptEqualAtUpperName
}

manual OptEqualAtUpperName {
    @option_none
    @option_some_tup2($Equal $AtUpperName)
}

manual Path {
    @vec_one(Name)
    @vec_snoc_separated(Path $DoubleColon Name)
}

#[derive(Debug, Clone, PartialEq, Eq)]
enum Name {
    Upper($UpperName)
    Lower($LowerName)
}

#[derive(Debug, Clone, PartialEq, Eq)]
enum UnderscoreOrLowerName {
    Underscore($Underscore)
    Lower($LowerName)
}

#[derive(Debug, Clone, PartialEq, Eq)]
enum GrammarSymbol {
    Upper($UpperName)
    DollarUpper($DollarUpperName)
}

#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
terminal Token {
    $StartKw
    $StructKw
    $EnumKw
    $ManualKw
    $TerminalKw
    $BridgeKw

    $Underscore
    $LParen
    $RParen
    $LSquare
    $RSquare
    $LCurly
    $RCurly
    $Comma
    $DoubleColon
    $Colon
    $Equal
    $Octothorpe

    $UpperName
    $LowerName
    $DollarUpperName
    $AtUpperName
    $AtLowerName

    $RustStringLiteral
}

bridge crate::mimi_bridge
